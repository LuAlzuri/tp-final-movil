@using System.Linq.Expressions

<div class="campo-contrasena position-relative">
    <InputText id="@Id" type="@(visible ? "text" : "password")" class="@($"form-control {InputClass}")"
               Value="@Value" ValueChanged="@ValueChanged" ValueExpression="@ValueExpression"
               placeholder="************" autocomplete="@Autocomplete" aria-describedby="@DescribedBy"
               autocapitalize="off" spellcheck="false" maxlength="128" disabled="@Disabled" />
    <button type="button" class="btn campo-contrasena-ojo position-absolute" aria-controls="@Id"
            aria-label="@($"{(visible ? "Ocultar" : "Mostrar")} {NombreCampo}")"
            disabled="@Disabled" @onclick="Alternar">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"
             aria-hidden="true" focusable="false">
            <path d="M2 12s3.6-6 10-6 10 6 10 6-3.6 6-10 6-10-6-10-6Z" />
            <circle cx="12" cy="12" r="2.5" />
            @if (visible)
            {
                <path d="m4 4 16 16" />
            }
        </svg>
    </button>
</div>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = string.Empty;
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public Expression<Func<string?>>? ValueExpression { get; set; }
    [Parameter] public string? InputClass { get; set; }
    [Parameter] public string Autocomplete { get; set; } = "new-password";
    [Parameter] public string? DescribedBy { get; set; }
    [Parameter] public string NombreCampo { get; set; } = "contraseña";
    [Parameter] public bool Disabled { get; set; }

    private bool visible;

    protected override void OnParametersSet()
    {
        if (Disabled || string.IsNullOrEmpty(Value))
            visible = false;
    }

    private void Alternar() => visible = !visible;
}
