@page "/inicio"
@attribute [Authorize]
@layout InicioLayout

<AuthorizeView>
    @{ var secciones = SeccionesInicio.Para(context.User); }
    @if (secciones.Count > 0)
    {
        <section class="inicio-opciones d-grid">
            <h1 class="visually-hidden">@(context.User.IsInRole(Roles.Administrador)
                ? "Inicio de administración" : "Inicio del veterinario")</h1>
            @foreach (var seccion in secciones)
            {
                <article class="inicio-tarjeta d-flex flex-column">
                    <h2 class="inicio-titulo fw-bold mb-0">@seccion.Titulo</h2>
                    <a href="@seccion.Ruta" class="btn inicio-ver rounded-pill fw-semibold align-self-end"
                       aria-label="@($"Ver {seccion.Titulo.ToLowerInvariant()}")">Ver</a>
                </article>
            }
        </section>
    }
    else if (context.User.IsInRole(Roles.Tutor))
    {
        <InicioTutor />
    }
</AuthorizeView>
