@page "/veterinario/tutores"
@attribute [Authorize(Roles = Roles.Veterinario)]
@layout InicioLayout
@using System.Globalization
@using Turnero.App.Tutores
@inject TutoresApi Api
@inject NavigationManager Navegacion
@implements IDisposable

<section class="gestion-pantalla">
    <div class="gestion-panel">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <h1 class="gestion-titulo gestion-titulo-listado mb-0">Tutores</h1>
            <a class="btn gestion-neutro rounded-pill fw-semibold" href="veterinario/tutores/nuevo">
                Agregar tutor
            </a>
        </div>

        <form class="gestion-busqueda d-flex gap-2 mt-3" role="search"
              @onsubmit="Buscar" @onsubmit:preventDefault>
            <label for="buscar-tutor" class="visually-hidden">Buscar tutor por nombre o apellido</label>
            <input id="buscar-tutor" class="form-control rounded-pill" type="search"
                   placeholder="Buscar tutor…" maxlength="200" @bind="textoBusqueda" @bind:event="oninput" />
            <button type="submit" class="btn gestion-principal gestion-buscar rounded-pill fw-semibold">Buscar</button>
        </form>

        @if (error is not null)
        {
            <p class="alert alert-danger mt-3 mb-0" role="alert">@error</p>
        }

        @if (cargando)
        {
            <p class="mt-4 mb-0" role="status">Cargando tutores…</p>
        }
        else if (errorCarga)
        {
            <button class="btn gestion-neutro rounded-pill mt-3" @onclick="CargarAsync">Reintentar</button>
        }
        else
        {
            var resultados = Filtrar();
            if (resultados.Count == 0)
            {
                <p class="mt-4 mb-0" role="status">@(string.IsNullOrWhiteSpace(Busqueda)
                    ? "Todavía no hay tutores registrados."
                    : "No encontramos tutores con ese nombre o apellido.")</p>
            }
            else
            {
                <ul class="gestion-listado list-unstyled d-grid mt-4 mb-0">
                    @foreach (var tutor in resultados)
                    {
                        <li class="gestion-tarjeta" @key="tutor.Id">
                            <h2 class="gestion-nombre">@tutor.NombreCompleto</h2>
                            <div class="d-flex flex-wrap justify-content-between gap-2">
                                <button type="button" class="btn btn-danger gestion-eliminar gestion-accion rounded-pill fw-semibold"
                                        aria-label="@($"Eliminar a {tutor.NombreCompleto}")"
                                        disabled="@eliminando" @onclick="() => PedirConfirmacionAsync(tutor)">Eliminar</button>
                                <a class="btn gestion-principal gestion-accion rounded-pill fw-semibold"
                                   href="@($"veterinario/tutores/{tutor.Id}")"
                                   aria-label="@($"Detalle de {tutor.NombreCompleto}")">Detalle</a>
                            </div>
                        </li>
                    }
                </ul>
            }
        }
    </div>
</section>

<DialogoBaja @ref="dialogo" Titulo="¿Eliminar tutor?" Introduccion="Se dará de baja a"
             Ocupado="@eliminando" Confirmar="EliminarAsync" />

@code {
    [SupplyParameterFromQuery(Name = "buscar")]
    public string? Busqueda { get; set; }

    private readonly CancellationTokenSource cancelacion = new();
    private List<Tutor> tutores = [];
    private string textoBusqueda = string.Empty;
    private string? error;
    private bool cargando = true;
    private bool errorCarga;
    private bool eliminando;
    private Tutor? seleccionado;
    private DialogoBaja dialogo = default!;

    protected override Task OnInitializedAsync() => CargarAsync();

    protected override void OnParametersSet() => textoBusqueda = Busqueda ?? string.Empty;

    private async Task CargarAsync()
    {
        cargando = true;
        error = null;
        errorCarga = false;
        try
        {
            tutores = await Api.ListarAsync(cancelacion.Token);
        }
        catch (GestionApiException ex)
        {
            error = ex.Message;
            errorCarga = true;
        }
        catch (OperationCanceledException) when (cancelacion.IsCancellationRequested) { }
        finally
        {
            cargando = false;
        }
    }

    private void Buscar()
    {
        var texto = textoBusqueda.Trim();
        Navegacion.NavigateTo(Navegacion.GetUriWithQueryParameter("buscar",
            texto.Length == 0 ? null : texto), replace: true);
    }

    private List<Tutor> Filtrar()
    {
        var terminos = Busqueda?.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries) ?? [];
        if (terminos.Length == 0)
            return tutores;

        var comparacion = CultureInfo.GetCultureInfo("es-AR").CompareInfo;
        return tutores.Where(tutor => terminos.All(termino =>
            comparacion.IndexOf(tutor.NombreCompleto, termino,
                CompareOptions.IgnoreCase | CompareOptions.IgnoreNonSpace) >= 0)).ToList();
    }

    private async Task PedirConfirmacionAsync(Tutor tutor)
    {
        seleccionado = tutor;
        await dialogo.AbrirAsync(tutor.NombreCompleto);
    }

    private async Task EliminarAsync()
    {
        if (eliminando || seleccionado is not { } tutor)
            return;

        eliminando = true;
        error = null;
        try
        {
            await Api.EliminarAsync(tutor.Id, cancelacion.Token);
            tutores.Remove(tutor);
        }
        catch (GestionApiException ex)
        {
            error = ex.Message;
        }
        catch (OperationCanceledException) when (cancelacion.IsCancellationRequested) { }
        finally
        {
            eliminando = false;
        }

        seleccionado = null;
        if (!cancelacion.IsCancellationRequested)
            await dialogo.CerrarAsync();
    }

    public void Dispose()
    {
        cancelacion.Cancel();
        cancelacion.Dispose();
    }
}
