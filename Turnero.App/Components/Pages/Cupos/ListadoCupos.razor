@page "/veterinario/cupos"
@attribute [Authorize(Roles = Roles.Veterinario)]
@layout InicioLayout
@using Turnero.App.Cupos
@inject CuposApi Api
@implements IDisposable

<section class="gestion-pantalla">
    <div class="gestion-panel">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <h1 class="gestion-titulo gestion-titulo-listado mb-0">Lista de cupos</h1>
            <a class="btn gestion-neutro rounded-pill fw-semibold" href="veterinario/cupos/nuevo">Agregar</a>
        </div>
        @if (error is not null)
        {
            <p class="alert alert-danger mt-3" role="alert">@error</p>
            <button type="button" class="btn gestion-neutro rounded-pill" @onclick="CargarAsync">Reintentar</button>
        }
        else if (cupos is null)
        {
            <p class="mt-3 mb-0" role="status">Cargando cupos…</p>
        }
        else if (cupos.Count == 0)
        {
            <p class="mt-3 mb-0" role="status">Todavía no hay cupos publicados.</p>
        }
        else
        {
            <ul class="gestion-listado list-unstyled d-grid mt-3 mb-0">
                @foreach (var cupo in cupos)
                {
                    <li class="gestion-tarjeta" @key="cupo.Id">
                        <div class="d-flex align-items-start justify-content-between flex-wrap gap-2">
                            <div>
                                <h2 class="gestion-nombre text-capitalize mb-1">@cupo.Dia</h2>
                                <time datetime="@cupo.FechaCupo.ToString("yyyy-MM-dd")" class="small">@cupo.FechaCupo.ToString("dd/MM/yyyy")</time>
                            </div>
                            <span class="badge rounded-pill text-bg-light border">
                                @cupo.CuposDisponibles de @cupo.CuposPublicados disponibles
                            </span>
                        </div>
                        <div class="d-flex justify-content-end mt-3">
                            <a class="btn gestion-principal gestion-accion rounded-pill fw-semibold"
                               href="@($"veterinario/cupos/{cupo.Id}")"
                               aria-label="@($"Ver cupos del {cupo.FechaCupo:dd/MM/yyyy}")">Ver</a>
                        </div>
                    </li>
                }
            </ul>
        }
    </div>
</section>

@code {
    private readonly CancellationTokenSource cancelacion = new();
    private List<CupoDiario>? cupos;
    private string? error;

    protected override Task OnInitializedAsync() => CargarAsync();

    private async Task CargarAsync()
    {
        error = null;
        try
        {
            cupos = await Api.ListarAsync(cancelacion.Token);
        }
        catch (GestionApiException ex)
        {
            error = ex.Message;
        }
        catch (OperationCanceledException) when (cancelacion.IsCancellationRequested) { }
    }

    public void Dispose()
    {
        cancelacion.Cancel();
        cancelacion.Dispose();
    }
}