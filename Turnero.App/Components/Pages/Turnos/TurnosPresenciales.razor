@page "/veterinario/turnos/presenciales"
@attribute [Authorize(Roles = Roles.Veterinario)]
@layout InicioLayout
@using Turnero.App.Tutores
@using Turnero.App.Vetos
@inject TutoresApi Tutores
@inject VetosApi Vetos
@implements IDisposable

<section class="gestion-pantalla">
    <div class="gestion-panel">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h1 class="gestion-titulo gestion-titulo-listado mb-0">Turnos presenciales</h1>
            <button type="button" class="btn gestion-neutro rounded-pill fw-semibold"
                    disabled="@cargando" @onclick="CargarAsync">Actualizar</button>
        </div>
        <p class="mt-3 mb-0">Seleccioná un tutor con veto vigente para reservar un turno.</p>
        @if (cargando)
        {
            <p class="mt-3 mb-0" role="status">Consultando tutores vetados…</p>
        }
        else if (error is not null)
        {
            <p class="alert alert-danger mt-3 mb-0" role="alert">@error</p>
            <button type="button" class="btn gestion-neutro rounded-pill mt-3" @onclick="CargarAsync">Reintentar</button>
        }
        else if (tutores.Count == 0)
        {
            <p class="alert alert-info mt-3 mb-0" role="status">No hay tutores vetados</p>
        }
        else
        {
            <ul class="gestion-listado list-unstyled d-grid mt-3 mb-0">
                @foreach (var tutor in tutores)
                {
                    <li class="gestion-tarjeta" @key="tutor.Id">
                        <h2 class="gestion-nombre">@tutor.NombreCompleto</h2>
                        <p class="small text-break mb-2">@tutor.Email</p>
                        <div class="d-flex justify-content-end">
                            <a href="@($"veterinario/tutores/{tutor.Id}/reserva-presencial")"
                               aria-label="@($"Reservar turno presencial para {tutor.NombreCompleto}")"
                               class="btn gestion-principal gestion-accion rounded-pill fw-semibold">Reservar</a>
                        </div>
                    </li>
                }
            </ul>
        }
    </div>
</section>

@code {
    private readonly CancellationTokenSource cancelacion = new();
    private List<Tutor> tutores = [];
    private bool cargando;
    private string? error;

    protected override Task OnInitializedAsync() => CargarAsync();

    private async Task CargarAsync()
    {
        if (cargando || cancelacion.IsCancellationRequested) return;
        cargando = true;
        error = null;
        tutores = [];
        var ct = cancelacion.Token;
        try
        {
            var activos = await Tutores.ListarAsync(ct);
            tutores = await Vetos.FiltrarTutoresVetadosAsync(activos, ct);
        }
        catch (GestionApiException ex) { error = ex.Message; }
        catch (OperationCanceledException) when (cancelacion.IsCancellationRequested) { }
        finally { cargando = false; }
    }

    public void Dispose() { cancelacion.Cancel(); cancelacion.Dispose(); }
}
