@inherits LayoutComponentBase
@implements IDisposable
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Sections
@using Microsoft.JSInterop
@inject SesionService Sesion
@inject NavigationManager Navegacion
@inject IJSRuntime Js

<div class="inicio-pantalla d-flex flex-column mx-auto">
    <header class="inicio-cabecera position-relative d-flex align-items-center justify-content-between gap-2">
        <AuthorizeView Roles="@SeccionesInicio.RolesConMenu">
            <Authorized>
                <p class="inicio-saludo fw-bold mb-0">¡Bienvenida, @(context.User.Identity?.Name)!</p>
                <button type="button" class="btn inicio-menu-boton"
                        aria-label="@(menuAbierto ? "Cerrar menú" : "Abrir menú")"
                        aria-controls="inicio-menu" aria-expanded="@(menuAbierto ? "true" : "false")"
                        @onclick="AlternarMenu">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
                        <path d="@(menuAbierto ? "M6 6l12 12M18 6 6 18" : "M4 6h16M4 12h16M4 18h16")" />
                    </svg>
                </button>
            </Authorized>
            <NotAuthorized>
                <AuthorizeView Roles="@Roles.Tutor" Context="tutor">
                    <Authorized>
                        @if (EsMenuMascota(tutor.User))
                        {
                            <SectionOutlet SectionName="mascota-tutor" />
                        }
                        else
                        {
                            <div class="d-flex align-items-center gap-2">
                                <span class="inicio-tutor-icono rounded-circle" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" focusable="false">
                                        <g transform="rotate(43 12 12)">
                                            <rect x="5" y="10" width="14" height="4" rx="2" />
                                            <circle cx="4.5" cy="9.5" r="3" /><circle cx="4.5" cy="14.5" r="3" />
                                            <circle cx="19.5" cy="9.5" r="3" /><circle cx="19.5" cy="14.5" r="3" />
                                        </g>
                                    </svg>
                                </span>
                                <p class="inicio-saludo fw-bold mb-0">¡Bienvenido, @(tutor.User.Identity?.Name)!</p>
                            </div>
                        }
                    </Authorized>
                    <NotAuthorized>
                        <p class="inicio-saludo fw-bold mb-0">VeteApp</p>
                    </NotAuthorized>
                </AuthorizeView>
            </NotAuthorized>
        </AuthorizeView>
    </header>

    <div class="inicio-cuerpo position-relative d-flex flex-column flex-grow-1">
        <AuthorizeView Roles="@SeccionesInicio.RolesConMenu">
            <nav id="inicio-menu" class="inicio-menu position-absolute"
                 aria-label="@(context.User.IsInRole(Roles.Administrador) ? "Menú de administración" : "Menú del veterinario")"
                 hidden="@(!menuAbierto)">
                <ul class="list-unstyled mb-0">
                    <li><a href="inicio" @onclick="CerrarMenu">Inicio</a></li>
                    @foreach (var seccion in SeccionesInicio.Para(context.User))
                    {
                        <li><a href="@seccion.Ruta" @onclick="CerrarMenu">@seccion.Titulo</a></li>
                    }
                    <li>
                        <button type="button" disabled="@cerrandoSesion" @onclick="CerrarSesionAsync">Cerrar sesión</button>
                    </li>
                </ul>
            </nav>
        </AuthorizeView>

        <main class="inicio-contenido flex-grow-1">
            @Body
        </main>

        <AuthorizeView>
            @{
                var menuMascota = EsMenuMascota(context.User);
                var mostrarAtajos = menuMascota || MostrarAtajos(context.User);
            }
            <footer class="inicio-pie d-flex justify-content-center align-items-center @(menuMascota ? "inicio-pie-mascota flex-row-reverse" : "")">
                @if (mostrarAtajos)
                {
                    <button type="button" class="btn inicio-atajo flex-fill" aria-label="Volver a la pantalla anterior"
                            @onclick="VolverAsync">
                        <img src="images/volver.svg" width="30" height="30" alt="" />
                    </button>
                    <a href="inicio" class="btn inicio-atajo flex-fill" aria-label="Ir a Inicio">
                        <img src="images/inicio.svg" width="32" height="32" alt="" />
                    </a>
                }
                @if (!menuMascota)
                {
                    <button type="button" class="btn inicio-atajo @(mostrarAtajos ? "flex-fill" : "")"
                            aria-label="Cerrar sesión" disabled="@cerrandoSesion" @onclick="CerrarSesionAsync">
                        <img src="images/salir.svg" width="32" height="32" alt="" />
                    </button>
                }
            </footer>
        </AuthorizeView>
    </div>
</div>

@code {
    private bool menuAbierto;
    private bool cerrandoSesion;
    private bool EsMenuMascota(ClaimsPrincipal usuario) =>
        usuario.IsInRole(Roles.Tutor) && Navegacion.ToBaseRelativePath(Navegacion.Uri)
            .StartsWith("tutor/mascotas/", StringComparison.OrdinalIgnoreCase);

    private bool MostrarAtajos(ClaimsPrincipal usuario) =>
        SeccionesInicio.AreaPara(usuario) is { } area && Navegacion.ToBaseRelativePath(Navegacion.Uri)
            .StartsWith($"{area}/", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized() => Navegacion.LocationChanged += AlCambiarUbicacion;

    private void AlternarMenu() => menuAbierto = !menuAbierto;

    private void CerrarMenu() => menuAbierto = false;

    private void AlCambiarUbicacion(object? sender, LocationChangedEventArgs args)
    {
        _ = InvokeAsync(() =>
        {
            CerrarMenu();
            StateHasChanged();
        });
    }

    private async Task VolverAsync()
    {
        if (!await Js.InvokeAsync<bool>("veteApp.volver"))
            Navegacion.NavigateTo("/inicio", replace: true);
    }

    private async Task CerrarSesionAsync()
    {
        if (cerrandoSesion)
            return;

        cerrandoSesion = true;
        try
        {
            await Sesion.CerrarSesionAsync();
            CerrarMenu();
            Navegacion.NavigateTo("/", replace: true);
        }
        finally
        {
            cerrandoSesion = false;
        }
    }

    public void Dispose() => Navegacion.LocationChanged -= AlCambiarUbicacion;
}
